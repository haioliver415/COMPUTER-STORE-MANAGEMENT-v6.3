<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h2 class="mb-1"><i class="bi bi-wrench"></i> <%= repairs.ticket_code %></h2><div class="text-muted"><%= repairs.customer_name %> · <%= repairs.customer_phone||'-' %></div></div><div class="d-flex gap-2"><a href="/repairs" class="btn btn-outline-secondary">Back</a><a target="_blank" href="/repairs/print/<%= repairs.id %>" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print</a></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="card mb-3"><div class="card-header"><h5>Repair Information</h5></div><div class="card-body py-3"><div class="row g-2 info-grid"><div class="col-md-6"><span class="info-label">Customer</span><strong><%= repairs.customer_name %></strong></div><div class="col-md-6"><span class="info-label">Phone</span><strong><%= repairs.customer_phone||'-' %></strong></div><div class="col-md-6"><span class="info-label">Device</span><strong><%= repairs.device_type %> · <%= repairs.device_model||'-' %></strong></div><div class="col-md-6"><span class="info-label">Received Items</span><strong><%= repairs.received_items||'-' %></strong></div><div class="col-12"><span class="info-label">Issue</span><div><%= repairs.issue_description %></div></div></div></div></div>
<div class="card"><div class="card-header"><h5>Update Repair</h5></div><div class="card-body"><form method="POST" action="/repairs/update/<%= repairs.id %>" id="repairUpdateForm"><div class="row g-2 compact-form"><div class="col-md-4"><label>Status</label><select name="status" class="form-select" <%= canManage?'':'disabled' %>><% ['received','diagnosing','repairing','ready','finished','delivered'].forEach(function(s){ %><option value="<%= s %>" <%= repairs.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-4"><label>Technician</label><select name="assigned_technician_id" class="form-select" <%= canManage?'':'disabled' %>><option value="">Unassigned</option><% technicians.forEach(function(t){ %><option value="<%= t.id %>" <%= Number(repairs.assigned_technician_id)===Number(t.id)?'selected':'' %>><%= t.name %></option><% }) %></select></div><div class="col-md-2"><label>Service Fee</label><input name="service_fee" id="detailServiceFee" type="number" min="0" step="0.01" value="<%= repairs.service_fee||0 %>" class="form-control repair-detail-price" <%= canPrice?'':'readonly' %>></div><div class="col-md-2"><label>Parts Cost</label><input name="parts_cost" id="detailPartsCost" type="number" min="0" step="0.01" value="<%= repairs.parts_cost||0 %>" class="form-control repair-detail-price" <%= canPrice?'':'readonly' %>></div><div class="col-12"><label>Notes</label><textarea name="notes" rows="2" class="form-control" <%= canManage?'':'readonly' %>><%= repairs.notes||'' %></textarea></div></div><div class="repair-total-strip mt-2"><span>Repair total</span><strong id="detailRepairTotal"><%= money((Number(repairs.service_fee)||0)+(Number(repairs.parts_cost)||0)) %></strong><small>Service Fee + Parts Cost</small></div><% if(canManage){ %><div class="mt-3 d-flex justify-content-end"><button class="btn btn-primary">Save Update</button></div><% } %></form></div></div></div>
<div class="col-lg-4"><div class="card mb-3"><div class="card-header"><h5>Summary</h5></div><div class="card-body compact-summary"><div><span>Status</span><span class="badge bg-info"><%= repairs.status %></span></div><div><span>Service Fee</span><strong><%= money(repairs.service_fee||0) %></strong></div><div><span>Parts Cost</span><strong><%= money(repairs.parts_cost||0) %></strong></div><div class="summary-total"><span>Total</span><strong><%= money((Number(repairs.service_fee)||0)+(Number(repairs.parts_cost)||0)) %></strong></div><div><span>Technician</span><strong><%= repairs.tech_name||'Unassigned' %></strong></div><% if(invoice){ %><div><span>Invoice</span><strong><%= invoice.invoice_code %></strong></div><% } %></div></div><div class="card"><div class="card-header"><h5>History</h5></div><div class="card-body p-0"><div class="list-group list-group-flush repair-history"><% events.forEach(function(e){ %><div class="list-group-item"><div class="d-flex justify-content-between gap-2"><strong><%= e.event_type %></strong><small class="text-muted text-nowrap"><%= new Date(e.created_at).toLocaleString() %></small></div><div class="small"><%= e.details||'-' %></div><div class="small text-muted"><%= e.user_name||'System' %></div></div><% }) %></div></div></div></div></div>
<script>function updateRepairTotal(){var a=Number(detailServiceFee.value)||0,b=Number(detailPartsCost.value)||0;detailRepairTotal.textContent='$'+(a+b).toFixed(2)}document.querySelectorAll('.repair-detail-price').forEach(x=>x.addEventListener('input',updateRepairTotal));</script>
