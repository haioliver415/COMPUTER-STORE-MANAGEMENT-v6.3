<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div><h2 class="mb-1"><i class="bi bi-wrench"></i> Repair Service</h2><div class="text-muted small">Customer intake, service fee + parts cost, technician workflow and printable repair slip.</div></div>
  <% if(canManage){ %><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#repairModal"><i class="bi bi-plus-lg"></i> New Ticket</button><% } %>
</div>

<div class="modal fade" id="repairModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><form id="repairCreateForm"><div class="modal-header"><h5>New Repair Ticket</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body compact-form"><input type="hidden" name="customer_id" id="repairCustomerId"><div class="row g-2">
<div class="col-md-6 position-relative"><label>Customer Name</label><input name="customer_name" id="repairCustomerName" class="form-control" placeholder="Walk-in User" autocomplete="off"><div class="suggestion-box d-none" id="nameSuggestions"></div></div>
<div class="col-md-6 position-relative"><label>Phone</label><input name="customer_phone" id="repairCustomerPhone" class="form-control" placeholder="Phone (optional)" autocomplete="off"><div class="suggestion-box d-none" id="phoneSuggestions"></div></div>
<div class="col-md-4"><label>Device Type</label><select name="device_type" class="form-select" required><option value="laptop">Laptop</option><option value="desktop">Desktop</option><option value="printer">Printer</option><option value="phone">Phone</option><option value="other">Other</option></select></div>
<div class="col-md-4"><label>Device Model</label><input name="device_model" class="form-control"></div>
<% if(canPrice){ %><div class="col-md-2"><label>Service Fee</label><input name="service_fee" id="newServiceFee" type="number" min="0" step="0.01" value="0" class="form-control repair-price-input"></div><div class="col-md-2"><label>Parts Cost</label><input name="parts_cost" id="newPartsCost" type="number" min="0" step="0.01" value="0" class="form-control repair-price-input"></div><% } %>
<div class="col-md-6"><label>Received Items</label><textarea name="received_items" class="form-control" rows="2" placeholder="Laptop + Charger + Bag ..."></textarea></div><div class="col-md-6"><label>Issue Description</label><textarea name="issue_description" class="form-control" rows="2" required></textarea></div>
<% if(canPrice){ %><div class="col-12"><div class="repair-total-strip"><span>Estimated total</span><strong id="newRepairTotal">$0.00</strong><small>Service Fee + Parts Cost</small></div></div><% } %>
</div><div class="alert alert-light border small mt-2 mb-0"><i class="bi bi-info-circle"></i> Select a saved customer from suggestions when available. Otherwise the ticket remains a walk-in repair.</div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button id="repairCreateBtn" class="btn btn-primary">Create Ticket</button></div></form></div></div></div>

<div class="card"><div class="card-body py-2"><form class="row g-2" method="GET"><div class="col-md-7"><input name="search" value="<%= search %>" class="form-control" placeholder="Ticket / phone / customer / device model"></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All Status</option><% ['received','diagnosing','repairing','ready','finished','delivered'].forEach(function(s){ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Search</button></div></form></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table table-nowrap align-middle mb-0"><thead class="table-dark"><tr><th>Ticket</th><th>Customer</th><th>Phone</th><th>Device</th><th>Fee</th><th>Parts</th><th>Total</th><th>Technician</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><% repairs.forEach(function(r){ var total=Number(r.actual_cost||0)||Number(r.estimated_cost||0); %><tr><td><strong><%= r.ticket_code %></strong><div class="small text-muted"><%= new Date(r.created_at).toLocaleString() %></div></td><td><%= r.display_customer_name||'Walk-in User' %></td><td><%= r.display_customer_phone||'-' %></td><td><%= r.device_type %><span class="text-muted ms-1"><%= r.device_model||'' %></span></td><td><%= money(r.service_fee||0) %></td><td><%= money(r.parts_cost||0) %></td><td class="fw-semibold"><%= money(total) %></td><td><%= r.tech_name||'Unassigned' %></td><td><span class="badge bg-<%= ['finished','delivered'].includes(r.status)?'success':r.status==='repairing'?'warning text-dark':'info' %>"><%= r.status %></span></td><td class="text-end"><div class="action-group justify-content-end"><a class="btn btn-sm btn-outline-info" href="/repairs/details/<%= r.id %>" title="Details"><i class="bi bi-pencil-square"></i></a><a class="btn btn-sm btn-outline-secondary" target="_blank" href="/repairs/print/<%= r.id %>" title="Print"><i class="bi bi-printer"></i></a><% if(canManage&&!['finished','delivered'].includes(r.status)){ %><button type="button" class="btn btn-sm btn-outline-success" onclick="finishRepair(<%= r.id %>)" title="Finish"><i class="bi bi-check2-circle"></i></button><% } %></div></td></tr><% }) %><% if(!repairs.length){ %><tr><td colspan="10" class="text-center text-muted py-4">No repair tickets.</td></tr><% } %></tbody></table></div></div>

<div class="modal fade" id="createdTicketModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header bg-success text-white"><h5><i class="bi bi-check-circle"></i> Ticket Created</h5><button class="btn-close btn-close-white" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body" id="createdTicketSummary"></div><div class="modal-footer"><a id="createdEditBtn" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Details</a><a id="createdPrintBtn" class="btn btn-primary" target="_blank"><i class="bi bi-printer"></i> Print</a></div></div></div></div>
<script>
(function(){
 const form=document.getElementById('repairCreateForm'); if(!form)return; const nameInput=document.getElementById('repairCustomerName'),phoneInput=document.getElementById('repairCustomerPhone'),cid=document.getElementById('repairCustomerId');let timer;
 function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
 function choose(c){cid.value=c.id;nameInput.value=c.name||'';phoneInput.value=c.phone||'';document.querySelectorAll('.suggestion-box').forEach(x=>x.classList.add('d-none'));}
 function suggest(input,box){clearTimeout(timer);timer=setTimeout(()=>{let q=input.value.trim();if(!q){box.classList.add('d-none');return;}fetch('/repairs/customer-suggestions?q='+encodeURIComponent(q)).then(r=>r.json()).then(list=>{box.innerHTML=list.map(c=>'<button type="button" class="suggestion-item" data-id="'+c.id+'"><strong>'+esc(c.name)+'</strong><span>'+esc(c.phone||c.email||'No contact')+'</span></button>').join('');box.classList.toggle('d-none',!list.length);box.querySelectorAll('button').forEach((b,i)=>b.onclick=()=>choose(list[i]));});},150);}
 nameInput.addEventListener('input',()=>{cid.value='';suggest(nameInput,document.getElementById('nameSuggestions'))});phoneInput.addEventListener('input',()=>{cid.value='';suggest(phoneInput,document.getElementById('phoneSuggestions'))});
 function total(){let a=Number((document.getElementById('newServiceFee')||{}).value)||0,b=Number((document.getElementById('newPartsCost')||{}).value)||0,t=document.getElementById('newRepairTotal');if(t)t.textContent='$'+(a+b).toFixed(2)}document.querySelectorAll('.repair-price-input').forEach(x=>x.addEventListener('input',total));total();
 form.addEventListener('submit',e=>{e.preventDefault();let btn=document.getElementById('repairCreateBtn');btn.disabled=true;fetch('/repairs/create',{method:'POST',headers:{'Accept':'application/json'},body:new URLSearchParams(new FormData(form))}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Create failed');bootstrap.Modal.getInstance(document.getElementById('repairModal')).hide();let x=d.repair;createdTicketSummary.innerHTML='<div class="ticket-receipt"><div class="h5">'+esc(x.ticket_code)+'</div><div><strong>Customer:</strong> '+esc(x.customer_name||'Walk-in User')+'</div><div><strong>Device:</strong> '+esc(x.device_type)+' '+esc(x.device_model||'')+'</div><div><strong>Total estimate:</strong> $'+Number(x.estimated_cost||0).toFixed(2)+'</div></div>';createdEditBtn.href='/repairs/details/'+x.id;createdPrintBtn.href='/repairs/print/'+x.id;bootstrap.Modal.getOrCreateInstance(createdTicketModal).show();form.reset();cid.value='';total();}).catch(err=>showToast(err.message,'danger')).finally(()=>btn.disabled=false);});
})();
function finishRepair(id){confirmDelete('Mark this repair as finished and create/update its invoice?',function(){fetch('/repairs/finish/'+id,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:''}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Failed');showToast('Repair finished. '+(d.invoice_code||''),'success');setTimeout(()=>location.reload(),450)}).catch(e=>showToast(e.message,'danger'))})}
</script>
