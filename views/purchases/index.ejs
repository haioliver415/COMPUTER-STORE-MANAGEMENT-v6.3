<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
<div class="d-flex justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2"><div><h2 class="mb-1"><i class="bi bi-bag-check"></i> Purchases</h2><div class="text-muted small">V6 flow: create Purchase Order first, then receive stock partially or fully. Supplier payments are recorded separately.</div></div><a href="/inventory" class="btn btn-outline-primary"><i class="bi bi-boxes"></i> Inventory &amp; Stock</a></div>

<div class="card mb-4"><div class="card-header"><div><h5 class="mb-0"><i class="bi bi-file-earmark-plus"></i> New Purchase Order</h5><small class="text-muted">Saving an order does not change stock. Use Receive after goods arrive.</small></div></div><div class="card-body">
<form id="purchaseForm"><div class="row g-2 mb-3">
  <div class="col-md-4"><label class="form-label">Dealer / Supplier</label><select id="supplierId" class="form-select supplier-search-select" data-placeholder="Search supplier name / phone / email" required><option value="">Select Dealer</option><% suppliers.forEach(function(s){ %><option value="<%= s.id %>" data-name="<%= s.name %>" data-phone="<%= s.phone||'' %>" data-email="<%= s.email||'' %>"><%= s.name %><%= s.phone ? ' · '+s.phone : '' %></option><% }) %></select></div>
  <div class="col-md-2"><label class="form-label">Tax Amount</label><input id="purchaseTax" type="number" class="form-control" value="0" min="0" step="0.01"></div>
  <div class="col-md-2"><label class="form-label">Initial Paid</label><input id="purchasePaid" type="number" class="form-control" value="0" min="0" step="0.01"></div>
  <div class="col-md-2"><label class="form-label">Payment</label><select id="purchasePaymentMethod" class="form-select"><option>cash</option><option>bank</option><option>card</option></select></div>
  <div class="col-md-2 d-flex align-items-end"><button type="button" class="btn btn-outline-primary w-100" onclick="addPurchaseRow()"><i class="bi bi-plus"></i> Add Item</button></div>
  <div class="col-12"><label class="form-label">Note</label><input id="purchaseNotes" class="form-control" placeholder="PO reference / delivery note (optional)"></div>
</div>
<div class="table-responsive"><table class="table table-sm align-middle" id="purchaseItems"><thead><tr><th style="min-width:280px">Product</th><th style="width:100px">Qty</th><th style="width:135px">Buy Price</th><th style="width:150px">Dealer Warranty</th><th class="text-end">Subtotal</th><th style="width:45px"></th></tr></thead><tbody></tbody></table></div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><div><span class="text-muted small me-2">Order subtotal</span><strong id="purchaseSubtotal">$0.00</strong></div><button type="submit" id="purchaseSubmit" class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Save Purchase Order</button></div>
</form></div></div>

<div class="card mb-4"><div class="card-header"><h5 class="mb-0">Purchase Orders</h5></div><div class="card-body p-0 table-responsive"><table class="table table-hover align-middle mb-0 compact-table"><thead class="table-dark"><tr><th>Code / Dealer</th><th>Receive</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Due</th><th>Status</th><th>Date</th><th class="text-end">Actions</th></tr></thead><tbody>
<% purchases.forEach(function(p){var orderStatus=p.order_status||'received'; %><tr><td><strong><%= p.purchase_code %></strong><div class="small text-muted"><%= p.supplier_name %></div></td><td><strong><%= p.received_units||0 %>/<%= p.ordered_units||0 %></strong><div class="progress mt-1" style="height:4px"><div class="progress-bar" style="width:<%= Number(p.ordered_units)?Math.min(100,Number(p.received_units)*100/Number(p.ordered_units)):0 %>%"></div></div></td><td class="text-end"><%= money(p.total) %></td><td class="text-end"><%= money(p.paid_amount) %></td><td class="text-end <%= Number(p.due_amount)>0?'text-danger fw-semibold':'' %>"><%= money(p.due_amount) %></td><td><span class="badge bg-<%= orderStatus==='received'?'success':orderStatus==='partial_received'?'warning text-dark':'secondary' %>"><%= orderStatus %></span><div class="small mt-1"><span class="badge bg-light text-dark border"><%= p.payment_status %></span></div></td><td><%= new Date(p.created_at).toLocaleString() %></td><td class="text-end"><div class="action-group justify-content-end"><button class="btn btn-sm btn-outline-info" onclick="openPurchaseDetail(<%= p.id %>)" title="Detail"><i class="bi bi-eye"></i></button><% if(orderStatus!=='received'&&orderStatus!=='cancelled'){ %><button class="btn btn-sm btn-outline-primary" onclick="openReceive(<%= p.id %>)" title="Receive"><i class="bi bi-box-arrow-in-down"></i></button><% } %><% if(Number(p.due_amount)>0){ %><button class="btn btn-sm btn-outline-success" onclick="openPurchasePay(<%= p.id %>,<%- JSON.stringify(p.purchase_code) %>,<%= Number(p.due_amount)||0 %>)" title="Pay supplier"><i class="bi bi-cash-coin"></i></button><% } %></div></td></tr><% }) %>
<% if(!purchases.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No purchase orders.</td></tr><% } %>
</tbody></table></div></div>

<div class="card"><div class="card-header"><h5 class="mb-0"><i class="bi bi-receipt"></i> Recent Supplier Payments</h5></div><div class="card-body p-0 table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Date</th><th>Payment</th><th>Supplier</th><th>Purchase</th><th>Method</th><th class="text-end">Amount</th><th>User</th></tr></thead><tbody><% payments.forEach(function(x){ %><tr><td><%= new Date(x.created_at).toLocaleString() %></td><td><code><%= x.payment_code %></code></td><td><%= x.supplier_name %></td><td><%= x.purchase_code||'-' %></td><td><%= x.payment_method %></td><td class="text-end fw-semibold"><%= money(x.amount) %></td><td><%= x.user_name||'-' %></td></tr><% }) %><% if(!payments.length){ %><tr><td colspan="7" class="text-center text-muted py-3">No supplier payments yet.</td></tr><% } %></tbody></table></div></div>

<div class="modal fade" id="receiveModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><div><h5 class="mb-0">Receive Purchase Stock</h5><small class="text-muted" id="receivePurchaseTitle"></small></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="receiveItems" class="vstack gap-2"></div><div class="mt-3"><label class="form-label">Receiving Note</label><input id="receiveNote" class="form-control" placeholder="Delivery note / optional"></div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button id="receiveConfirmBtn" class="btn btn-primary" onclick="submitReceive()"><i class="bi bi-box-arrow-in-down"></i> Confirm Receive</button></div></div></div></div>
<div class="modal fade" id="purchasePayModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content"><div class="modal-header"><h5>Pay Supplier</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="purchasePaySummary" class="alert alert-light border small"></div><label class="form-label">Amount</label><input id="purchasePayAmount" type="number" min="0.01" step="0.01" class="form-control mb-2"><label class="form-label">Method</label><select id="purchasePayMethod" class="form-select mb-2"><option>cash</option><option>bank</option><option>card</option></select><label class="form-label">Reference</label><input id="purchasePayRef" class="form-control"></div><div class="modal-footer"><button id="purchasePayBtn" class="btn btn-success" onclick="submitPurchasePay()">Save Payment</button></div></div></div></div>
<div class="modal fade" id="purchaseDetailModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><div><h5 class="mb-0">Purchase Detail</h5><small id="purchaseDetailTitle" class="text-muted"></small></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="purchaseDetailBody"></div></div></div></div>

<script>
var purchaseProducts=<%- JSON.stringify(products).replace(/</g,'\\u003c') %>,activeReceiveId=null,activePayId=null;
function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function productOptions(){return '<option value="">Select product</option>'+purchaseProducts.map(function(p){return '<option value="'+p.id+'" data-price="'+Number(p.buy_price||0)+'">'+esc(p.name)+' · '+esc(p.product_code||'-')+' (Stock '+p.stock_qty+')</option>'}).join('')}
function addPurchaseRow(){var tr=document.createElement('tr');tr.innerHTML='<td><select class="form-select form-select-sm p-product product-search-select" data-placeholder="Search product / code / barcode / unit / serial" onchange="setPurchasePrice(this)" required>'+productOptions()+'</select></td><td><input class="form-control form-control-sm p-qty" type="number" min="1" value="1" oninput="calcPurchase()"></td><td><input class="form-control form-control-sm p-price" type="number" min="0" step="0.01" value="0" oninput="calcPurchase()"></td><td><div class="input-group input-group-sm"><input class="form-control p-warranty" type="number" min="0" value="12"><span class="input-group-text">mo</span></div></td><td class="p-subtotal text-end">$0.00</td><td><button type="button" class="btn btn-sm btn-light" onclick="this.closest(\'tr\').remove();calcPurchase()"><i class="bi bi-x-lg"></i></button></td>';document.querySelector('#purchaseItems tbody').appendChild(tr);initProductSearchSelect(tr.querySelector('.p-product'));calcPurchase()}
function setPurchasePrice(sel){var o=sel.selectedOptions[0];sel.closest('tr').querySelector('.p-price').value=o?Number(o.dataset.price||0).toFixed(2):'0.00';calcPurchase()}
function calcPurchase(){var total=0;document.querySelectorAll('#purchaseItems tbody tr').forEach(function(r){var q=Number(r.querySelector('.p-qty').value)||0,p=Number(r.querySelector('.p-price').value)||0,s=q*p;total+=s;r.querySelector('.p-subtotal').textContent='$'+s.toFixed(2)});purchaseSubtotal.textContent='$'+total.toFixed(2)}
purchaseForm.addEventListener('submit',function(e){e.preventDefault();var items=[];document.querySelectorAll('#purchaseItems tbody tr').forEach(function(r){if(r.querySelector('.p-product').value)items.push({product_id:r.querySelector('.p-product').value,quantity:r.querySelector('.p-qty').value,buy_price:r.querySelector('.p-price').value,dealer_warranty_months:r.querySelector('.p-warranty').value})});if(!supplierId.value)return showToast('Select a dealer/supplier.','warning');if(!items.length)return showToast('Add a purchase item.','warning');purchaseSubmit.disabled=true;fetch('/suppliers/purchase',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({supplier_id:supplierId.value,tax:purchaseTax.value,paid_amount:purchasePaid.value,payment_method:purchasePaymentMethod.value,notes:purchaseNotes.value,items})}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Purchase failed');showToast('Purchase Order '+d.purchase_code+' saved. Stock is not changed until Receive.','success');setTimeout(()=>location.reload(),700)}).catch(err=>{showToast(err.message,'danger');purchaseSubmit.disabled=false})});
function splitSerials(v){return String(v||'').split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean)}
function loadPurchase(id){return fetch('/suppliers/purchase/'+id).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Load failed');return d})}
function openReceive(id){activeReceiveId=id;receiveItems.innerHTML='<div class="text-center py-4">Loading...</div>';bootstrap.Modal.getOrCreateInstance(receiveModal).show();loadPurchase(id).then(d=>{receivePurchaseTitle.textContent=d.purchase.purchase_code+' · '+d.purchase.supplier_name;receiveItems.innerHTML=d.items.map(function(x){var remain=Number(x.quantity)-Number(x.received_qty||0);if(remain<=0)return '';var serialDisabled=x.tracking_mode==='quantity'?'disabled':'';return '<div class="receive-line" data-item-id="'+x.id+'" data-mode="'+x.tracking_mode+'"><div class="d-flex justify-content-between gap-2"><div><strong>'+esc(x.product_name)+'</strong><div class="small text-muted"><code>'+esc(x.product_code||'-')+'</code> · Ordered '+x.quantity+' · Received '+x.received_qty+' · Remaining '+remain+'</div></div><div style="width:110px"><label class="small text-muted">Receive Qty</label><input class="form-control form-control-sm r-qty" type="number" min="0" max="'+remain+'" value="'+remain+'"></div></div><div class="mt-2"><label class="small text-muted">Serial Number(s) '+(x.tracking_mode==='required'?'· required':x.tracking_mode==='quantity'?'· not used':'· optional')+'</label><textarea class="form-control form-control-sm r-serials" rows="2" '+serialDisabled+' placeholder="One serial per line. Empty values are skipped."></textarea></div></div>'}).join('')||'<div class="alert alert-success mb-0">This purchase is fully received.</div>'}).catch(e=>{receiveItems.innerHTML='<div class="alert alert-danger">'+esc(e.message)+'</div>'})}
function submitReceive(){var items=[],bad='';document.querySelectorAll('#receiveItems .receive-line').forEach(function(row){var qty=Math.max(0,parseInt(row.querySelector('.r-qty').value,10)||0),mode=row.dataset.mode,serials=splitSerials(row.querySelector('.r-serials').value);if(qty>0){if(mode==='required'&&serials.length!==qty)bad='Serial Required row needs exactly '+qty+' serial(s).';if(mode==='quantity'&&serials.length)bad='Quantity-only row cannot use serials.';if(new Set(serials.map(x=>x.toUpperCase())).size!==serials.length)bad='Duplicate serial in a receiving row.';items.push({purchase_item_id:Number(row.dataset.itemId),quantity:qty,serial_numbers:serials.join('\n')})}});if(bad)return showToast(bad,'warning');if(!items.length)return showToast('Enter at least one receive quantity.','warning');receiveConfirmBtn.disabled=true;fetch('/suppliers/purchase/'+activeReceiveId+'/receive',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items,notes:receiveNote.value})}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Receive failed');showToast('Received successfully · '+d.receipt_code,'success');setTimeout(()=>location.reload(),600)}).catch(e=>{showToast(e.message,'danger');receiveConfirmBtn.disabled=false})}
function openPurchasePay(id,code,due){activePayId=id;purchasePaySummary.textContent=code+' · Due $'+Number(due).toFixed(2);purchasePayAmount.value=Number(due).toFixed(2);purchasePayAmount.max=due;purchasePayRef.value='';bootstrap.Modal.getOrCreateInstance(purchasePayModal).show()}
function submitPurchasePay(){var amount=Number(purchasePayAmount.value)||0;if(amount<=0)return showToast('Enter payment amount.','warning');purchasePayBtn.disabled=true;fetch('/suppliers/purchase/'+activePayId+'/pay',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount,payment_method:purchasePayMethod.value,reference:purchasePayRef.value})}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Payment failed');showToast('Supplier payment '+d.payment_code+' saved.','success');setTimeout(()=>location.reload(),600)}).catch(e=>{showToast(e.message,'danger');purchasePayBtn.disabled=false})}
function openPurchaseDetail(id){purchaseDetailBody.innerHTML='<div class="text-center py-4">Loading...</div>';bootstrap.Modal.getOrCreateInstance(purchaseDetailModal).show();loadPurchase(id).then(d=>{purchaseDetailTitle.textContent=d.purchase.purchase_code+' · '+d.purchase.supplier_name;var items='<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Product</th><th class="text-center">Ordered</th><th class="text-center">Received</th><th class="text-end">Price</th></tr></thead><tbody>'+d.items.map(x=>'<tr><td>'+esc(x.product_name)+'<div class="small text-muted">'+esc(x.product_code||'')+'</div></td><td class="text-center">'+x.quantity+'</td><td class="text-center">'+x.received_qty+'</td><td class="text-end">$'+Number(x.buy_price).toFixed(2)+'</td></tr>').join('')+'</tbody></table></div>';var pays='<h6 class="mt-3">Payments</h6>'+(d.payments.length?d.payments.map(x=>'<div class="d-flex justify-content-between border-bottom py-1"><span>'+esc(x.payment_code)+' · '+esc(x.payment_method)+'</span><strong>$'+Number(x.amount).toFixed(2)+'</strong></div>').join(''):'<div class="text-muted small">No payments.</div>');purchaseDetailBody.innerHTML=items+pays}).catch(e=>{purchaseDetailBody.innerHTML='<div class="alert alert-danger">'+esc(e.message)+'</div>'})}
addPurchaseRow();
</script>
