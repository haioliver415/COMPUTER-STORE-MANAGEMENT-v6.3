<!doctype html>
<html lang="<%= settings.language==='km'?'km':'en' %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Receipt <%= sale.sale_code %></title>
<style>
*{box-sizing:border-box}body{margin:0;background:#eef1f5;font-family:Arial,'Noto Sans Khmer',sans-serif;color:#111}.toolbar{max-width:420px;margin:20px auto 0;display:flex;gap:8px}.toolbar button,.toolbar a{flex:1;padding:10px 12px;border-radius:8px;border:1px solid #d0d5dd;background:#fff;text-decoration:none;text-align:center;color:#111;font-weight:600;cursor:pointer}.toolbar .primary{background:#111827;color:#fff;border-color:#111827}.receipt{width:80mm;max-width:100%;margin:12px auto 28px;background:#fff;padding:7mm 5mm;box-shadow:0 10px 30px #0001}.center{text-align:center}.store{font-size:18px;font-weight:800}.muted{color:#667085;font-size:11px}.rule{border-top:1px dashed #777;margin:10px 0}.row{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin:4px 0}.item{margin:8px 0}.item-name{font-size:12px;font-weight:700}.item-meta{font-size:10px;color:#667085}.item-line{display:grid;grid-template-columns:1fr 45px 62px;text-align:right;font-size:11px;margin-top:3px}.item-line span:first-child{text-align:left}.total{font-size:15px;font-weight:800}.thank{margin-top:14px;font-size:11px;text-align:center;color:#475467}@media print{body{background:white}.toolbar{display:none}.receipt{box-shadow:none;margin:0 auto;width:80mm;padding:4mm}.no-print{display:none}@page{size:80mm auto;margin:0}}
</style>
</head><body>
<div class="toolbar no-print"><a href="/pos">Back to POS</a><button class="primary" onclick="window.print()">Print / Save PDF</button></div>
<div class="receipt">
  <div class="center"><div class="store"><%= settings.store_name || 'Computer Store' %></div><div class="muted"><%= settings.address || '' %></div><div class="muted"><%= settings.phone || '' %></div></div>
  <div class="rule"></div>
  <div class="row"><span>Receipt</span><strong><%= sale.sale_code %></strong></div>
  <div class="row"><span>Date</span><span><%= new Date(sale.created_at).toLocaleString() %></span></div>
  <div class="row"><span>Cashier</span><span><%= sale.cashier_name || '-' %></span></div>
  <div class="row"><span>Customer</span><span><%= sale.customer_name || 'USER' %></span></div>
  <% if(sale.customer_phone){ %><div class="row"><span>Phone</span><span><%= sale.customer_phone %></span></div><% } %>
  <div class="rule"></div>
  <% items.forEach(function(item){ var serials=unitsByItem[String(item.id)]||[]; %>
    <div class="item">
      <div class="item-name"><%= item.product_name %></div>
      <div class="item-meta"><%= [item.product_code,item.model].filter(Boolean).join(' · ') %></div>
      <% if(serials.length){ %><div class="item-meta">Serial / Unit: <%= serials.join(', ') %></div><% } %>
      <div class="item-line"><span><%= item.quantity %> × $<%= Number(item.unit_price).toFixed(2) %></span><span></span><strong>$<%= Number(item.subtotal).toFixed(2) %></strong></div>
    </div>
  <% }) %>
  <div class="rule"></div>
  <div class="row"><span>Subtotal</span><span>$<%= Number(sale.subtotal||0).toFixed(2) %></span></div>
  <% if(Number(sale.discount||0)>0){ %><div class="row"><span>Discount</span><span>-$<%= Number(sale.discount).toFixed(2) %></span></div><% } %>
  <% if(Number(sale.tax||0)>0){ %><div class="row"><span>Tax</span><span>$<%= Number(sale.tax).toFixed(2) %></span></div><% } %>
  <div class="row total"><span>Total</span><span>$<%= Number(sale.total||0).toFixed(2) %></span></div>
  <div class="row"><span>Payment</span><span><%= sale.payment_method %></span></div>
  <div class="row"><span>Paid</span><span>$<%= Number(sale.paid_amount||0).toFixed(2) %></span></div>
  <% if(Number(sale.change_amount||0)>0){ %><div class="row"><span>Change</span><span>$<%= Number(sale.change_amount).toFixed(2) %></span></div><% } %>
  <div class="thank">Thank you for your purchase.</div>
</div>
<script>
window.addEventListener('afterprint',function(){ if(<%= autoPrint ? 'true' : 'false' %>) setTimeout(function(){location.href='/pos'},250); });
<% if(autoPrint){ %>window.addEventListener('load',function(){setTimeout(function(){window.print()},250)});<% } %>
</script>
</body></html>
