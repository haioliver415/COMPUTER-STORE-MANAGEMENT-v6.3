<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h2 class="mb-1"><i class="bi bi-gear"></i> <%= t('settings') %></h2><div class="text-muted small">Store, PostgreSQL, backup/restore, users, permissions and recovery.</div></div><a href="/auth/register" class="btn btn-outline-primary"><i class="bi bi-person-plus"></i> Add User</a></div>

<div class="settings-grid">
  <div class="card"><div class="card-header"><h5><i class="bi bi-shop"></i> Store Information</h5></div><div class="card-body"><form method="POST" action="/settings/update"><input type="hidden" name="language" value="<%= settings.language==='km'?'km':'en' %>"><div class="row g-2 compact-form"><div class="col-md-6"><label>Store Name</label><input name="store_name" class="form-control" value="<%= settings.store_name %>" required></div><div class="col-md-3"><label>Phone</label><input name="phone" class="form-control" value="<%= settings.phone||'' %>"></div><div class="col-md-3"><label>Tax %</label><input name="tax_rate" type="number" step="0.01" class="form-control" value="<%= settings.tax_rate %>"></div><div class="col-12"><label>Address</label><input name="address" class="form-control" value="<%= settings.address||'' %>"></div><div class="col-md-2"><label>Symbol</label><input name="currency_symbol" class="form-control" value="<%= settings.currency_symbol %>"></div><div class="col-md-2"><label>Code</label><input name="currency_code" class="form-control" value="<%= settings.currency_code %>"></div><div class="col-md-2"><label>2nd Symbol</label><input name="second_currency_symbol" class="form-control" value="<%= settings.second_currency_symbol %>"></div><div class="col-md-2"><label>2nd Code</label><input name="second_currency_code" class="form-control" value="<%= settings.second_currency_code %>"></div><div class="col-md-4"><label>Exchange Rate</label><input name="exchange_rate" type="number" step="0.01" class="form-control" value="<%= settings.exchange_rate %>"></div></div><div class="d-flex justify-content-between align-items-center mt-3"><div class="d-flex gap-1"><button type="button" class="btn btn-sm <%= settings.language!=='km'?'btn-primary':'btn-outline-primary' %>" onclick="setLanguage('en')">English</button><button type="button" class="btn btn-sm <%= settings.language==='km'?'btn-primary':'btn-outline-primary' %>" onclick="setLanguage('km')">ខ្មែរ</button></div><button class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Store</button></div></form><form id="languageForm" method="POST" action="/settings/language" class="d-none"><input id="languageValue" name="language"></form></div></div>

  <div class="card"><div class="card-header"><div><h5 class="mb-0"><i class="bi bi-database-gear"></i> PostgreSQL / Multi-PC</h5><div class="small text-muted">All PCs can connect to one central PostgreSQL server.</div></div><span class="badge bg-success">Configured</span></div><div class="card-body"><form id="databaseForm"><div class="row g-2 compact-form"><div class="col-md-7"><label>Host / Server IP</label><input name="host" class="form-control" value="<%= dbConfig.host %>" required></div><div class="col-md-5"><label>Port</label><input name="port" type="number" class="form-control" value="<%= dbConfig.port %>" required></div><div class="col-md-6"><label>Database</label><input name="database" class="form-control" value="<%= dbConfig.database %>" required></div><div class="col-md-6"><label>Username</label><input name="user" class="form-control" value="<%= dbConfig.user %>" required></div><div class="col-md-6"><label>Password</label><input name="password" type="password" class="form-control" placeholder="Leave blank to keep current"></div><div class="col-md-6 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" name="ssl" value="1" type="checkbox" <%= dbConfig.ssl?'checked':'' %>><span class="form-check-label">Use SSL</span></label></div></div><div class="d-flex gap-2 mt-3"><button type="button" id="dbTestBtn" class="btn btn-outline-primary"><i class="bi bi-plug"></i> Test</button><button class="btn btn-primary" id="dbSaveBtn"><i class="bi bi-check-lg"></i> Save Connection</button></div><div id="dbMsg" class="small mt-2 text-muted"><% if(dbConfig.environmentOverride){ %>Environment DB_* values are overriding local saved values.<% } else { %>Use the same host/database/login on every PC.<% } %></div></form></div></div>
</div>

<div class="card mb-3"><div class="card-header"><div><h5 class="mb-0"><i class="bi bi-person-gear"></i> Users & Access</h5><div class="small text-muted">Admin controls both page access and what actions each user can perform.</div></div></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table table-nowrap mb-0"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Modules</th><th>Actions</th><th>Active</th><th class="text-end">Control</th></tr></thead><tbody>
<% users.forEach(function(u){ %><tr><td><strong><%= u.name %></strong></td><td><%= u.email %></td><td><span class="badge bg-light text-dark border"><%= u.role %></span></td><td><% if(u.role==='admin'){ %><span class="access-chip">All</span><% } else { %><span class="access-chip"><%= u.access.length %> modules</span><% } %></td><td><% if(u.role==='admin'){ %><span class="access-chip">All</span><% } else { %><span class="access-chip"><%= u.permissions.length %> actions</span><% } %></td><td><span class="badge bg-<%= u.is_active?'success':'secondary' %>"><%= u.is_active?'Enabled':'Disabled' %></span></td><td class="text-end"><div class="action-group justify-content-end"><% if(u.role!=='admin'){ %><button class="btn btn-sm btn-outline-primary" type="button" onclick='openUserAccess(<%- JSON.stringify({id:u.id,name:u.name,role:u.role,access:u.access,permissions:u.permissions}).replace(/</g,"\\u003c") %>)' title="Access"><i class="bi bi-ui-checks-grid"></i></button><% } %><% if(u.id!==user.id){ %><form method="POST" action="/auth/toggle/<%= u.id %>" class="d-inline"><button class="btn btn-sm <%= u.is_active?'btn-outline-danger':'btn-outline-success' %>" title="<%= u.is_active?'Disable user':'Enable user' %>"><i class="bi bi-power"></i></button></form><% } %></div></td></tr><% }) %>
</tbody></table></div></div>

<div class="modal fade" id="userAccessModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><div><h5 class="mb-0">User Access & Permissions</h5><small class="text-muted" id="userAccessTitle"></small></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="accessUserId"><div class="row g-3"><div class="col-md-6"><h6>Module Access</h6><div class="user-access-grid" id="userAccessGrid"><% accessKeys.filter(function(k){return k!=='settings'}).forEach(function(k){ %><label class="form-check permission-choice"><input class="form-check-input access-check" type="checkbox" value="<%= k %>"><span class="form-check-label"><%= accessLabels[k]||k %></span></label><% }) %></div></div><div class="col-md-6"><h6>Action Permissions</h6><div class="user-access-grid" id="userPermissionGrid"><% actionKeys.forEach(function(k){ %><label class="form-check permission-choice"><input class="form-check-input permission-check" type="checkbox" value="<%= k %>"><span class="form-check-label"><%= actionLabels[k]||k %></span></label><% }) %></div></div></div><div class="alert alert-light border small mt-3 mb-0">Unticking a module hides it and blocks direct access. Action permissions control sensitive operations inside allowed modules.</div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveAccessBtn" onclick="saveUserAccess()">Save Access</button></div></div></div></div>

<div class="row g-3 mb-3"><div class="col-lg-7"><div class="card h-100"><div class="card-header"><div><h5 class="mb-0"><i class="bi bi-database-check"></i> Database Backup & Restore</h5><div class="small text-muted">Backup downloads full PostgreSQL schema + data. Restore replaces current database data.</div></div></div><div class="card-body"><div class="d-flex gap-2 flex-wrap mb-3"><a href="/settings/backup" class="btn btn-success"><i class="bi bi-download"></i> Backup .sql</a><button class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#restoreBox"><i class="bi bi-arrow-counterclockwise"></i> Restore .sql</button></div><div class="collapse" id="restoreBox"><div class="restore-panel"><div class="alert alert-warning py-2 small"><strong>Warning:</strong> Restore replaces current data. The system creates a safety backup automatically before applying the uploaded file.</div><form id="restoreForm"><div class="row g-2 compact-form"><div class="col-md-7"><label>Backup file</label><input class="form-control" name="backup_file" type="file" accept=".sql" required></div><div class="col-md-5"><label>Type RESTORE</label><input class="form-control" name="confirm_text" placeholder="RESTORE" required></div></div><button class="btn btn-danger mt-2" id="restoreBtn"><i class="bi bi-arrow-repeat"></i> Restore Database</button></form><div id="restoreMsg" class="small mt-2"></div></div></div></div></div></div>
<div class="col-lg-5"><div class="card h-100"><div class="card-header"><h5><i class="bi bi-trash3"></i> Deleted Products</h5></div><div class="card-body"><form method="POST" action="/settings/deleted-products/retention" class="d-flex gap-2 align-items-end flex-wrap"><div><label class="form-label">Auto archive after</label><div class="input-group"><input name="days" type="number" min="1" max="3650" class="form-control" value="<%= settings.deleted_product_retention_days||30 %>"><span class="input-group-text">days</span></div></div><button class="btn btn-primary">Save</button><button type="button" class="btn btn-outline-secondary" onclick="purgeRecycleNow()">Cleanup</button></form><div class="small text-muted mt-2">Products with stock are kept recoverable and are not auto-archived until stock is zero. Archived history: <strong><%= archivedCount %></strong>.</div></div></div></div></div>

<div class="card mb-3"><div class="card-header"><h5><i class="bi bi-arrow-counterclockwise"></i> Recycle Bin</h5></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table table-nowrap mb-0"><thead><tr><th>Product</th><th>Code</th><th>Stock Preserved</th><th>Deleted</th><th class="text-end">Action</th></tr></thead><tbody><% deletedProducts.forEach(function(p){ %><tr><td><strong><%= p.name %></strong><span class="text-muted ms-1"><%= p.model||'' %></span></td><td><code><%= p.product_code||'-' %></code></td><td><%= p.stock_qty||0 %></td><td><%= new Date(p.deleted_at).toLocaleString() %></td><td class="text-end"><button class="btn btn-sm btn-outline-success" onclick="restoreProduct(<%= p.id %>)"><i class="bi bi-arrow-counterclockwise"></i> Restore</button></td></tr><% }) %><% if(!deletedProducts.length){ %><tr><td colspan="5" class="text-center text-muted py-3">Recycle Bin is empty.</td></tr><% } %></tbody></table></div></div>

<div class="card"><div class="card-header"><h5><i class="bi bi-clock-history"></i> System Activity</h5></div><div class="card-body p-0 table-responsive" style="max-height:320px"><table class="table table-sm table-nowrap mb-0"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody><% activity.forEach(function(a){ %><tr><td><%= new Date(a.created_at).toLocaleString() %></td><td><%= a.user_name||'-' %></td><td><%= a.action %></td><td class="text-truncate-cell"><%= a.details||'-' %></td></tr><% }) %></tbody></table></div></div>

<script>
function setLanguage(v){languageValue.value=v;languageForm.submit()}
function openUserAccess(u){accessUserId.value=u.id;userAccessTitle.textContent=u.name+' · '+u.role;document.querySelectorAll('.access-check').forEach(c=>c.checked=(u.access||[]).includes(c.value));document.querySelectorAll('.permission-check').forEach(c=>c.checked=(u.permissions||[]).includes(c.value));bootstrap.Modal.getOrCreateInstance(userAccessModal).show()}
function saveUserAccess(){var id=accessUserId.value,access=Array.from(document.querySelectorAll('.access-check:checked')).map(c=>c.value),permissions=Array.from(document.querySelectorAll('.permission-check:checked')).map(c=>c.value),btn=saveAccessBtn;btn.disabled=true;Promise.all([fetch('/settings/user/'+id+'/access',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({access})}).then(r=>r.json()),fetch('/settings/user/'+id+'/permissions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissions})}).then(r=>r.json())]).then(ds=>{var bad=ds.find(d=>!d.success);if(bad)throw new Error(bad.message||'Save failed');showToast('User access updated.','success');setTimeout(()=>location.reload(),350)}).catch(e=>{showToast(e.message,'danger');btn.disabled=false})}
function restoreProduct(id){fetch('/products/restore/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.message||'Restore failed');showToast('Product restored.','success');setTimeout(()=>location.reload(),350)}).catch(e=>showToast(e.message,'danger'))}
function purgeRecycleNow(){confirmDelete('Run deleted-product cleanup now?',()=>fetch('/settings/deleted-products/purge-now',{method:'POST'}).then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.message||'Cleanup failed');showToast('Archived '+d.purged+' expired product(s).','success');setTimeout(()=>location.reload(),400)}).catch(e=>showToast(e.message,'danger')))}
function dbPayload(){var f=new FormData(databaseForm);return {host:f.get('host'),port:f.get('port'),database:f.get('database'),user:f.get('user'),password:f.get('password'),ssl:!!f.get('ssl')}}
dbTestBtn.onclick=function(){dbMsg.className='small mt-2 text-muted';dbMsg.textContent='Testing...';fetch('/settings/database/test',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(dbPayload())}).then(r=>r.json().then(d=>({ok:r.ok,d}))).then(x=>{if(!x.ok||!x.d.success)throw new Error(x.d.message||'Failed');dbMsg.className='small mt-2 text-success';dbMsg.textContent='Connected to '+x.d.server.database+' as '+x.d.server.username}).catch(e=>{dbMsg.className='small mt-2 text-danger';dbMsg.textContent=e.message})}
databaseForm.onsubmit=function(e){e.preventDefault();confirmDelete('Save this database connection? You will be signed out and must log in using a user from the selected database.',function(){dbSaveBtn.disabled=true;fetch('/settings/database/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(dbPayload())}).then(r=>r.json().then(d=>({ok:r.ok,d}))).then(x=>{if(!x.ok||!x.d.success)throw new Error(x.d.message||'Save failed');location.href='/auth/login'}).catch(e=>{dbMsg.className='small mt-2 text-danger';dbMsg.textContent=e.message;dbSaveBtn.disabled=false})})}
restoreForm.onsubmit=function(e){e.preventDefault();var f=new FormData(restoreForm);if(String(f.get('confirm_text')||'').toUpperCase()!=='RESTORE')return showToast('Type RESTORE to confirm.','warning');confirmDelete('Restore this database backup now? Current data will be replaced after a safety backup is created.',function(){restoreBtn.disabled=true;restoreMsg.className='small mt-2 text-muted';restoreMsg.textContent='Restoring...';fetch('/settings/restore',{method:'POST',body:f}).then(r=>r.json().then(d=>({ok:r.ok,d}))).then(x=>{if(!x.ok||!x.d.success)throw new Error(x.d.message||'Restore failed');restoreMsg.className='small mt-2 text-success';restoreMsg.textContent=x.d.message;setTimeout(()=>location.href='/auth/login',700)}).catch(e=>{restoreMsg.className='small mt-2 text-danger';restoreMsg.textContent=e.message;restoreBtn.disabled=false})})}
</script>
