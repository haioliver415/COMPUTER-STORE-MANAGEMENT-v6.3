<% if(typeof success!=='undefined'&&success){ %><div class="alert alert-success"><%= success %></div><% } %>
<% if(typeof errorMessage!=='undefined'&&errorMessage){ %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
<div class="d-flex justify-content-between align-items-center mt-3 mb-3"><div><h2 class="mb-1"><i class="bi bi-people"></i> <%= t('customers') %></h2><div class="text-muted small">Compact customer list with purchase history and due balance.</div></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#customerModal"><i class="bi bi-plus-lg"></i> Add Customer</button></div>
<div class="modal fade" id="customerModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" action="/customers/create"><div class="modal-header"><h5>Add Customer</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-2"><div class="col-12"><label>Name</label><input name="name" class="form-control" required></div><div class="col-6"><label>Phone</label><input name="phone" class="form-control"></div><div class="col-6"><label>Email</label><input name="email" type="email" class="form-control"></div><div class="col-12"><label>Address</label><textarea name="address" class="form-control" rows="2"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save</button></div></form></div></div></div>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table table-hover align-middle mb-0 compact-table"><thead class="table-dark"><tr><th>Customer</th><th>Phone</th><th class="text-center">Purchases</th><th class="text-end">Spent</th><th class="text-end">Due</th><th>Last Purchase</th><th class="text-end">Actions</th></tr></thead><tbody>
<% customers.forEach(function(c){ %><tr><td><div class="fw-semibold"><%= c.name %></div><div class="small text-muted"><%= c.email||'-' %></div></td><td><%= c.phone||'-' %></td><td class="text-center"><span class="badge bg-light text-dark border"><%= c.purchase_count||0 %></span></td><td class="text-end"><%= money(c.lifetime_spend) %></td><td class="text-end <%= Number(c.due_balance)>0?'text-danger fw-bold':'' %>"><%= money(c.due_balance) %></td><td><%= c.last_purchase?new Date(c.last_purchase).toLocaleDateString():'-' %></td><td class="text-end"><div class="action-group justify-content-end"><a class="btn btn-sm btn-outline-info" href="/customers/report/<%= c.id %>" title="Purchase report"><i class="bi bi-file-earmark-bar-graph"></i></a><button class="btn btn-sm btn-outline-primary" onclick='openCustomerEdit(<%- JSON.stringify({id:c.id,name:c.name,phone:c.phone||"",email:c.email||"",address:c.address||""}).replace(/</g,"\\u003c") %>)'><i class="bi bi-pencil"></i></button><% if(Number(c.due_balance)>0){ %><button class="btn btn-sm btn-outline-success" onclick="openPay(<%= c.id %>,<%- JSON.stringify(c.name) %>,<%= Number(c.due_balance)||0 %>)"><i class="bi bi-cash-coin"></i></button><% } %></div></td></tr><% }) %>
</tbody></table></div></div>
<div class="modal fade" id="customerEditModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" id="customerEditForm"><div class="modal-header"><h5>Edit Customer</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-2"><div class="col-12"><label>Name</label><input id="ceName" name="name" class="form-control" required></div><div class="col-6"><label>Phone</label><input id="cePhone" name="phone" class="form-control"></div><div class="col-6"><label>Email</label><input id="ceEmail" name="email" class="form-control"></div><div class="col-12"><label>Address</label><textarea id="ceAddress" name="address" class="form-control"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-primary">Save</button></div></form></div></div></div>
<div class="modal fade" id="payModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content"><form method="POST" id="payForm"><div class="modal-header"><h5>Collect Due</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="paySummary" class="alert alert-light border small"></div><label class="form-label">Amount</label><input name="amount" id="payAmount" type="number" min="0.01" step="0.01" class="form-control mb-2" required><label class="form-label">Payment Method</label><select name="payment_method" class="form-select mb-2"><option>cash</option><option>bank</option><option>card</option></select><label class="form-label">Reference</label><input name="reference" class="form-control" placeholder="Optional receipt/bank reference"></div><div class="modal-footer"><button class="btn btn-success">Receive</button></div></form></div></div></div>

<div class="card mt-4"><div class="card-header"><h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Customer Payments</h5></div><div class="card-body p-0 table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Date</th><th>Payment</th><th>Customer</th><th>Method</th><th>Reference</th><th class="text-end">Amount</th><th>User</th></tr></thead><tbody><% (payments||[]).forEach(function(x){ %><tr><td><%= new Date(x.created_at).toLocaleString() %></td><td><code><%= x.payment_code %></code></td><td><%= x.customer_name %></td><td><%= x.payment_method %></td><td><%= x.reference||'-' %></td><td class="text-end fw-semibold"><%= money(x.amount) %></td><td><%= x.user_name||'-' %></td></tr><% }) %><% if(!(payments||[]).length){ %><tr><td colspan="7" class="text-center text-muted py-3">No customer payments yet.</td></tr><% } %></tbody></table></div></div>
<script>function openCustomerEdit(c){customerEditForm.action='/customers/update/'+c.id;ceName.value=c.name;cePhone.value=c.phone;ceEmail.value=c.email;ceAddress.value=c.address;bootstrap.Modal.getOrCreateInstance(customerEditModal).show()}function openPay(id,name,due){payForm.action='/customers/pay/'+id;paySummary.textContent=name+' · Due '+moneyClient(due);payAmount.max=due;payAmount.value=due.toFixed(2);bootstrap.Modal.getOrCreateInstance(payModal).show()}function moneyClient(n){return '$'+Number(n||0).toFixed(2)}</script>
