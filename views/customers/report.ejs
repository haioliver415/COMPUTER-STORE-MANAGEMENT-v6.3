<div class="d-flex justify-content-between align-items-center mt-3 mb-3 no-print"><div><h2 class="mb-1"><i class="bi bi-file-earmark-person"></i> Customer Purchase Report</h2><div class="text-muted"><%= customer.name %> · <%= customer.phone||'-' %></div></div><div class="d-flex gap-2"><a href="/customers" class="btn btn-outline-secondary">Back</a><button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button></div></div>
<div class="card mb-3"><div class="card-body"><div class="row"><div class="col-md-4"><strong>Customer</strong><div><%= customer.name %></div></div><div class="col-md-4"><strong>Phone</strong><div><%= customer.phone||'-' %></div></div><div class="col-md-4"><strong>Due Balance</strong><div><%= money(customer.due_balance) %></div></div></div></div></div>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Date</th><th>Sale</th><th>Product</th><th>Code</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead><tbody><% items.forEach(function(i){ %><tr><td><%= new Date(i.created_at).toLocaleString() %></td><td><%= i.sale_code %></td><td><%= i.product_name %></td><td><code><%= i.product_code||'-' %></code></td><td><%= i.quantity %></td><td><%= money(i.unit_price) %></td><td><%= money(i.subtotal) %></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No purchase history.</td></tr><% } %></tbody></table></div></div>
