  <div class="card shadow-lg">
    <div class="card-body p-5">
      <div class="text-center mb-4">
        <i class="bi bi-shop display-1 text-primary"></i>
        <h3 class="mt-2">Computer Store</h3>
        <p class="text-muted">Management System</p>
      </div>
      <form method="POST" action="/auth/login" autocomplete="on">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required placeholder="Enter email" value="admin@store.com" autocomplete="username" autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required placeholder="Enter password" value="admin123" autocomplete="current-password">
        </div>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Login</button>
      </form>
      <hr>
      <div class="text-center text-muted">
        <small>Admin: admin@store.com / admin123</small><br>
        <small>Manager: rose@store.com / mgr123</small><br>
        <small>Cashier: juan@store.com / cash123</small><br>
        <small>Technician: mike@store.com / tech123</small>
      </div>
    </div>
  </div>
