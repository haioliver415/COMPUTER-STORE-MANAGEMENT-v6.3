  <div class="card shadow-lg">
    <div class="card-body p-5">
      <div class="text-center mb-4">
        <i class="bi bi-person-plus display-1 text-primary"></i>
        <h3 class="mt-2">Create Account</h3>
      </div>
      <form method="POST" action="/auth/register">
        <div class="mb-3">
          <label class="form-label">Full Name</label>
          <input type="text" name="name" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Role</label>
          <select name="role" class="form-select">
            <option value="admin">Admin</option>
            <option value="manager">Manager</option>
            <option value="cashier">Cashier</option>
            <option value="technician">Technician</option>
            <option value="stock">Stock (read-only Warranty lookup)</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus"></i> Create</button>
        <div class="mt-3 text-center"><a href="/settings">Back to Settings</a></div>
      </form>
    </div>
  </div>
