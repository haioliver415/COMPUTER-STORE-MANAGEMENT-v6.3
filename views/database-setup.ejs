<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Database Setup</title><link href="/vendor/bootstrap.min.css" rel="stylesheet"><link href="/css/icons.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head>
<body class="db-setup-body"><div class="db-setup-shell"><div class="card db-setup-card"><div class="card-header"><div><h4 class="mb-1"><i class="bi bi-database-gear"></i> PostgreSQL Connection</h4><div class="small text-muted">Use one PostgreSQL database for one PC or many PCs on the same network.</div></div><span class="badge bg-<%= dbReady?'success':'warning text-dark' %>"><%= dbReady?'Connected':'Setup required' %></span></div><div class="card-body">
<% if(dbError){ %><div class="alert alert-warning py-2"><strong>Last connection:</strong> <%= dbError %></div><% } %>
<div class="alert alert-light border small">For multiple PCs, enter the IP address of the computer/server running PostgreSQL (example: <code>192.168.1.10</code>). Every PC must use the same database name, username and password.</div>
<form id="dbSetupForm"><div class="row g-2 compact-form"><div class="col-md-7"><label>Database Host / Server IP</label><input name="host" class="form-control" value="<%= dbConfig.host %>" required></div><div class="col-md-5"><label>Port</label><input name="port" type="number" class="form-control" value="<%= dbConfig.port %>" required></div><div class="col-md-6"><label>Database Name</label><input name="database" class="form-control" value="<%= dbConfig.database %>" required></div><div class="col-md-6"><label>PostgreSQL User</label><input name="user" class="form-control" value="<%= dbConfig.user %>" required></div><div class="col-md-6"><label>Password</label><input name="password" type="password" class="form-control" placeholder="<%= dbConfig.hasPassword?'Leave blank to keep current password':'PostgreSQL password' %>"></div><div class="col-md-6 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" name="ssl" value="1" type="checkbox" <%= dbConfig.ssl?'checked':'' %>><span class="form-check-label">Use SSL connection</span></label></div></div><div class="d-flex gap-2 mt-3"><button type="button" class="btn btn-outline-primary" id="testBtn"><i class="bi bi-plug"></i> Test Connection</button><button class="btn btn-primary" id="saveBtn"><i class="bi bi-check-lg"></i> Save & Connect</button></div></form><div id="dbSetupMsg" class="small mt-3"></div></div></div></div>
<script>
const form=document.getElementById('dbSetupForm'),msg=document.getElementById('dbSetupMsg');function payload(){const f=new FormData(form);return {host:f.get('host'),port:f.get('port'),database:f.get('database'),user:f.get('user'),password:f.get('password'),ssl:!!f.get('ssl')}}function post(url){msg.className='small mt-3 text-muted';msg.textContent='Connecting...';return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())}).then(async r=>{const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Connection failed');return d})}testBtn.onclick=()=>post('/database-setup/test').then(d=>{msg.className='small mt-3 text-success';msg.textContent='Connected: '+(d.server.database||'')+' as '+(d.server.username||'')}).catch(e=>{msg.className='small mt-3 text-danger';msg.textContent=e.message});form.onsubmit=e=>{e.preventDefault();saveBtn.disabled=true;post('/database-setup/save').then(d=>{msg.className='small mt-3 text-success';msg.textContent=d.message;setTimeout(()=>location.href=d.redirect||'/auth/login',600)}).catch(e=>{msg.className='small mt-3 text-danger';msg.textContent=e.message;saveBtn.disabled=false})};
</script></body></html>
