<!doctype html><html><head><meta charset="utf-8"><title>Physical Stock Count</title><style>body{font-family:Arial,sans-serif;margin:20px;color:#111}h2{margin:0}.meta{display:flex;justify-content:space-between;margin-bottom:18px}.line{display:inline-block;border-bottom:1px solid #333;min-width:160px}table{border-collapse:collapse;width:100%;font-size:10px;table-layout:auto}th,td{border:1px solid #777;padding:4px 5px;text-align:left;white-space:nowrap;line-height:1.15}th{background:#eee}.blank{height:18px;min-width:58px}@media print{button{display:none}}</style></head><body><div class="meta"><div><h2><%= settings.store_name||'Computer Store' %></h2><div>Physical Stock Reconciliation</div></div><div>Date: <span class="line"></span><br><br>Counted by: <span class="line"></span></div></div><table><thead><tr><% columns.forEach(function(c){ %><th><%= c.label %></th><% }) %><th>Actual Qty</th><th>Difference</th><th>Remark</th></tr></thead><tbody><% rows.forEach(function(r,rowIndex){ %><tr><% columns.forEach(function(c){ %><td><%= c.field === '__row_no' ? rowIndex + 1 : (r[c.field] == null ? '' : r[c.field]) %></td><% }) %><td class="blank"></td><td class="blank"></td><td class="blank"></td></tr><% }) %></tbody></table><div style="text-align:center;margin-top:16px"><button onclick="window.print()">Print</button></div></body></html>
