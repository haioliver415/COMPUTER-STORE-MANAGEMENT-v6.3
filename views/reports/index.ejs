<% var defaultCols=['no','product_code','name','model','category','system_qty','status']; %>
<div class="d-flex justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2"><div><h2 class="mb-1"><i class="bi bi-graph-up"></i> <%= t('reports') %></h2><div class="text-muted small"><%= user.role==='stock' ? t('stock_report_hint') : t('reports_hint') %></div></div></div>

<div class="row g-3 mb-3" id="reportKpis">
  <div class="col-sm-6 col-xl-3"><div class="report-kpi report-filter-card active" data-filter="all" onclick="applyReportCardFilter('all',this)"><span><%= t('product_models') %></span><strong><%= stock.length %></strong><small class="text-muted">Click to show all models</small></div></div>
  <div class="col-sm-6 col-xl-3"><div class="report-kpi report-filter-card" data-filter="stock" onclick="applyReportCardFilter('stock',this)"><span><%= t('system_stock') %></span><strong><%= stock.reduce(function(s,p){return s+Number(p.stock_qty||0)},0) %></strong><small class="text-muted">Products with stock</small></div></div>
  <div class="col-sm-6 col-xl-3"><div class="report-kpi report-filter-card" data-filter="low" onclick="applyReportCardFilter('low',this)"><span>LOW</span><strong><%= stock.filter(function(p){return p.stock_status==='LOW'}).length %></strong><small class="text-muted">Click to list low stock</small></div></div>
  <div class="col-sm-6 col-xl-3"><div class="report-kpi report-filter-card" data-filter="out" onclick="applyReportCardFilter('out',this)"><span>OUT STOCK</span><strong><%= stock.filter(function(p){return p.stock_status==='OUT STOCK'}).length %></strong><small class="text-muted">Click to list out of stock</small></div></div>
</div>

<div class="card mb-3">
  <div class="card-header flex-wrap gap-2">
    <div><h5 class="mb-1"><i class="bi bi-clipboard-check"></i> Stock Dashboard / Physical Count</h5><div class="small text-muted">Click a card above to filter this dashboard. Choose columns controls both the screen and export/print.</div></div>
    <div class="d-flex gap-2 flex-wrap ms-auto">
      <div class="dropdown" data-bs-auto-close="outside"><button class="btn btn-sm btn-outline-secondary dropdown-toggle px-3" type="button" data-bs-toggle="dropdown"><i class="bi bi-layout-three-columns"></i> Choose columns</button><div class="dropdown-menu dropdown-menu-end report-column-menu"><div class="fw-semibold small mb-2">Show and export / print columns</div><% Object.keys(stockColumnOptions).forEach(function(k){ %><div class="form-check"><input class="form-check-input stock-col" id="col-<%= k %>" type="checkbox" value="<%= k %>" <%= defaultCols.includes(k)?'checked':'' %> onchange="syncVisibleColumns()"><label class="form-check-label small" for="col-<%= k %>"><%= stockColumnOptions[k][0] %></label></div><% }) %><div class="border-top mt-2 pt-2 d-flex gap-2"><button type="button" class="btn btn-sm btn-light" onclick="selectDefaultColumns()">Default</button><button type="button" class="btn btn-sm btn-light" onclick="selectAllColumns()">All</button></div></div></div>
      <% if(hasPermission('report_export')){ %><div class="dropdown"><button class="btn btn-sm btn-success dropdown-toggle px-3" type="button" data-bs-toggle="dropdown"><i class="bi bi-download"></i> Export</button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" onclick="printStockAudit()"><i class="bi bi-printer me-2"></i><%= t('print_count_sheet') %></button></li><li><button class="dropdown-item" type="button" onclick="exportSelected('stock','xlsx')"><i class="bi bi-file-earmark-excel me-2"></i>Excel (.xlsx)</button></li><li><button class="dropdown-item" type="button" onclick="exportSelected('stock','csv')"><i class="bi bi-filetype-csv me-2"></i>CSV</button></li></ul></div><% } %>
    </div>
  </div>
  <div class="card-body border-bottom py-2"><div class="row g-2 align-items-center"><div class="col-lg-7"><div class="input-group input-group-sm"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="stockSearch" class="form-control" placeholder="Product Code / Product / Model / Category" oninput="filterStockTable()"></div></div><div class="col-lg-3"><select id="stockStatusFilter" class="form-select form-select-sm" onchange="setManualStatusFilter()"><option value="">All Status</option><option value="OK">OK</option><option value="LOW">LOW</option><option value="OUT STOCK">OUT STOCK</option></select></div><div class="col-lg-2 text-lg-end"><span class="small text-muted" id="reportVisibleCount"><%= stock.length %> rows</span></div></div></div>
  <div class="card-body p-0 table-responsive"><table class="table table-hover compact-table table-tight table-nowrap report-stock-table mb-0" id="stockReportTable"><thead class="table-dark"><tr>
    <% Object.keys(stockColumnOptions).forEach(function(k){ %><th class="stock-col-<%= k %> <%= defaultCols.includes(k)?'':'d-none' %>"><%= stockColumnOptions[k][0] %></th><% }) %>
    <th style="width:95px">Actual Qty</th><th style="width:90px">Difference</th>
  </tr></thead><tbody>
  <% stock.forEach(function(p,i){ %><tr data-search="<%= ([p.product_code,p.name,p.model,p.category_name].filter(Boolean).join(' ')).toLowerCase() %>" data-status="<%= p.stock_status %>" data-stock="<%= Number(p.stock_qty||0) %>">
    <% Object.keys(stockColumnOptions).forEach(function(k){ var v=''; if(k==='no')v=i+1; else if(k==='category')v=p.category_name; else if(k==='tracking')v=p.tracking_mode; else if(k==='system_qty')v=p.stock_qty; else if(k==='own')v=p.own_stock; else if(k==='dealer')v=p.dealer_stock; else if(k==='legacy')v=p.legacy_stock; else if(k==='damaged')v=p.damaged_stock; else if(k==='lost')v=p.lost_stock; else if(k==='status')v=p.stock_status; else if(k==='buy_price')v=money(p.buy_price); else if(k==='sell_price')v=money(p.sell_price); else v=p[k]||'-'; %><td class="stock-col-<%= k %> <%= defaultCols.includes(k)?'':'d-none' %>"><% if(k==='product_code'){ %><code><%= v||'-' %></code><% } else if(k==='name'){ %><strong><%= v %></strong><% } else if(k==='status'){ %><span class="stock-pill stock-<%= p.stock_status==='OK'?'ok':p.stock_status==='LOW'?'low':'out' %>"><%= p.stock_status %></span><% } else { %><%= v %><% } %></td><% }) %>
    <td><input class="form-control form-control-sm actual-input" type="number" min="0" data-system="<%= p.stock_qty %>" oninput="calcDiff(this)"></td><td class="fw-bold diff-cell">-</td>
  </tr><% }) %></tbody></table></div>
  <div class="card-footer small text-muted"><i class="bi bi-info-circle"></i> <%= t('count_sheet_footer') %></div>
</div>

<% if(['admin','manager'].includes(user.role)){ %>
<div class="card mb-3"><div class="card-header"><h5><i class="bi bi-receipt"></i> Sales Report</h5></div><div class="card-body"><div class="row g-2"><div class="col-md-2"><button class="btn btn-outline-primary w-100" onclick="loadSales('today')">Today</button></div><div class="col-md-2"><button class="btn btn-outline-primary w-100" onclick="loadSales('week')">This Week</button></div><div class="col-md-2"><button class="btn btn-outline-primary w-100" onclick="loadSales('month')">This Month</button></div><div class="col-md-2"><input type="date" id="salesFrom" class="form-control"></div><div class="col-md-2"><input type="date" id="salesTo" class="form-control"></div><div class="col-md-2"><button class="btn btn-primary w-100" onclick="loadSales('custom')">Custom</button></div></div><div class="mt-3" id="salesResults"><span class="text-muted">Loading...</span></div></div></div>
<div class="card"><div class="card-header"><h5><i class="bi bi-wrench"></i> Repair Report</h5><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-primary" onclick="exportSimple('repairs','csv')">CSV</button><button class="btn btn-sm btn-outline-success" onclick="exportSimple('repairs','xlsx')">Excel</button></div></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table table-nowrap mb-0"><thead><tr><th>Ticket</th><th>Customer</th><th>Phone</th><th>Device</th><th>Status</th><th>Technician</th><th class="text-end">Cost</th></tr></thead><tbody><% repairs.slice(0,100).forEach(function(r){ %><tr><td><%= r.ticket_code %></td><td><%= r.customer_name %></td><td><%= r.customer_phone||'-' %></td><td><%= r.device_type %> <%= r.device_model||'' %></td><td><%= r.status %></td><td><%= r.tech_name||'-' %></td><td class="text-end"><%= money(r.actual_cost||r.estimated_cost||0) %></td></tr><% }) %></tbody></table></div></div>
<% } %>
<script>
var reportCardFilter='all';
function selectedStockCols(){return Array.from(document.querySelectorAll('.stock-col:checked')).map(function(x){return x.value}).join(',')}
function syncVisibleColumns(){var checked=new Set(Array.from(document.querySelectorAll('.stock-col:checked')).map(function(x){return x.value}));document.querySelectorAll('.stock-col').forEach(function(c){document.querySelectorAll('.stock-col-'+c.value).forEach(function(cell){cell.classList.toggle('d-none',!checked.has(c.value))})})}
function selectDefaultColumns(){var defaults=<%- JSON.stringify(defaultCols) %>;document.querySelectorAll('.stock-col').forEach(function(c){c.checked=defaults.includes(c.value)});syncVisibleColumns()}
function selectAllColumns(){document.querySelectorAll('.stock-col').forEach(function(c){c.checked=true});syncVisibleColumns()}
function exportSelected(type,fmt){var cols=selectedStockCols();if(!cols)return showToast('Choose at least one column.','warning');window.location.href=fmt==='xlsx'?'/reports/export-excel/'+type+'?columns='+encodeURIComponent(cols):'/reports/export/'+type+'?columns='+encodeURIComponent(cols)}
function exportSimple(type,fmt){window.location.href=fmt==='xlsx'?'/reports/export-excel/'+type:'/reports/export/'+type}
function printStockAudit(){var cols=selectedStockCols();if(!cols)return showToast('Choose at least one column.','warning');window.open('/reports/stock-audit/print?columns='+encodeURIComponent(cols),'_blank')}
function calcDiff(input){var actual=input.value===''?null:Number(input.value),sys=Number(input.dataset.system)||0,cell=input.closest('tr').querySelector('.diff-cell');cell.textContent=actual===null?'-':String(actual-sys);cell.classList.toggle('text-danger',actual!==null&&actual!==sys);cell.classList.toggle('text-success',actual!==null&&actual===sys)}
function applyReportCardFilter(type,card){reportCardFilter=type;document.querySelectorAll('.report-filter-card').forEach(function(x){x.classList.toggle('active',x===card)});if(type==='low'||type==='out')stockStatusFilter.value=type==='low'?'LOW':'OUT STOCK';else stockStatusFilter.value='';filterStockTable()}
function setManualStatusFilter(){reportCardFilter='all';document.querySelectorAll('.report-filter-card').forEach(function(x){x.classList.toggle('active',x.dataset.filter==='all')});filterStockTable()}
function filterStockTable(){var q=stockSearch.value.trim().toLowerCase(),status=stockStatusFilter.value,shown=0;document.querySelectorAll('#stockReportTable tbody tr').forEach(function(r){var okQ=!q||(r.dataset.search||'').includes(q),okS=!status||r.dataset.status===status,okCard=reportCardFilter==='all'||(reportCardFilter==='stock'&&Number(r.dataset.stock)>0)||(reportCardFilter==='low'&&r.dataset.status==='LOW')||(reportCardFilter==='out'&&r.dataset.status==='OUT STOCK');var show=okQ&&okS&&okCard;r.classList.toggle('d-none',!show);if(show)shown++});reportVisibleCount.textContent=shown+' row'+(shown===1?'':'s')}
syncVisibleColumns();filterStockTable();
<% if(['admin','manager'].includes(user.role)){ %>
function escapeReport(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;')}
function loadSales(period){var u='/reports/api/sales?period='+period;if(period==='custom'){var f=salesFrom.value,t=salesTo.value;if(!f||!t)return showToast('Choose From and To dates.','warning');u='/reports/api/sales?start_date='+encodeURIComponent(f)+'&end_date='+encodeURIComponent(t)}fetch(u).then(function(r){return r.json()}).then(function(d){var total=d.sales.reduce(function(a,s){return a+Number(s.total||0)},0);var h='<div class="row g-2 mb-3"><div class="col-md-4"><div class="report-kpi"><span>Sales</span><strong>'+d.sales.length+'</strong></div></div><div class="col-md-4"><div class="report-kpi"><span>Revenue</span><strong>$'+total.toFixed(2)+'</strong></div></div><div class="col-md-4"><div class="report-kpi"><span>Estimated Profit</span><strong>$'+Number(d.profit||0).toFixed(2)+'</strong></div></div></div><div class="table-responsive"><table class="table table-sm table-nowrap"><thead><tr><th>Sale</th><th>Customer</th><th>Total</th><th>Payment</th><th>Date</th></tr></thead><tbody>';d.sales.slice(0,100).forEach(function(s){h+='<tr><td>'+escapeReport(s.sale_code)+'</td><td>'+escapeReport(s.customer_name||'USER')+'</td><td>$'+Number(s.total||0).toFixed(2)+'</td><td>'+escapeReport(s.payment_method)+'</td><td>'+escapeReport(new Date(s.created_at).toLocaleString())+'</td></tr>'});h+='</tbody></table></div>';salesResults.innerHTML=h}).catch(function(){showToast('Could not load sales report.','danger')})}
loadSales('today');
<% } %>
</script>
