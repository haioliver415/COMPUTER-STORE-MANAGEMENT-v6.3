<% function remainText(status,days){ if(status==='valid') return days===0?'Ends today':days+' day(s) left'; if(status==='expired') return Math.abs(days||0)+' day(s) expired'; if(status==='not_applicable') return 'N/A'; return 'Not available'; } %>
<% function statusClass(status){ return status==='valid'?'ok':status==='expired'?'out':'low'; } %>
<div class="d-flex justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2"><div><h2 class="mb-1"><i class="bi bi-shield-check"></i> Warranty & After-Sales</h2><div class="text-muted small"><%= t('warranty_search_hint') %></div></div><% if(user.role==='stock'){ %><a href="/reports" class="btn btn-outline-primary"><i class="bi bi-clipboard-data"></i> <%= t('stock_report') %></a><% } %></div>
<% if(success){ %><div class="alert alert-success"><%= success %></div><% } %><% if(errorMessage){ %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

<div class="card mb-4"><div class="card-header"><div><h5 class="mb-1"><i class="bi bi-search"></i> <%= t('find_sold_item') %></h5><div class="small text-muted"><%= t('search_by_serial_model_date') %></div></div></div><div class="card-body">
<form method="GET" action="/after-sales" class="row g-2 align-items-end">
  <div class="col-xl-5 col-lg-12"><label class="form-label"><%= t('search') %></label><input name="q" value="<%= q %>" class="form-control" placeholder="Serial / Unit Code / Product Code / Model / Sale Code / Customer / Dealer"></div>
  <div class="col-xl-2 col-md-4"><label class="form-label"><%= t('sale_date') %></label><input type="date" name="sale_date" value="<%= saleDate %>" class="form-control"></div>
  <div class="col-xl-2 col-md-4"><label class="form-label"><%= t('sale_month') %></label><input type="month" name="sale_month" value="<%= saleMonth %>" class="form-control"></div>
  <div class="col-xl-1 col-md-4"><label class="form-label"><%= t('year') %></label><input type="number" min="2000" max="2100" name="sale_year" value="<%= saleYear %>" class="form-control" placeholder="2026"></div>
  <div class="col-xl-2 col-md-6"><label class="form-label"><%= t('received_date') %></label><input type="date" name="received_date" value="<%= receivedDate %>" class="form-control"></div>
  <div class="col-12 d-flex justify-content-end gap-2 mt-3"><a href="/after-sales" class="btn btn-light"><%= t('clear') %></a><button class="btn btn-primary"><i class="bi bi-search"></i> <%= t('search') %></button></div>
</form></div></div>

<div class="card mb-4"><div class="card-header"><div><h5 class="mb-1"><%= t('item_warranty_results') %></h5><div class="small text-muted"><%= warrantyRows.length %> item(s) · newest activity first</div></div></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table align-middle mb-0"><thead class="table-dark"><tr><th>Product / Model</th><th>Serial / Code</th><th><%= t('sold') %></th><th>Source / Dealer</th><th><%= t('customer') %></th><th>Store Warranty</th><th>Dealer Warranty</th><th></th></tr></thead><tbody>
<% if(!warrantyRows.length){ %><tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-search fs-3 d-block mb-2"></i><%= t('no_matching_item') %></td></tr><% } %>
<% warrantyRows.forEach(function(r){ var detail={id:r.id,product:r.product_name,model:r.model||'',code:r.product_code||'',serial:r.serial_number||'',stockCode:r.internal_code,source:r.source_type,dealer:r.supplier_name||'',received:r.received_at?String(r.received_at).slice(0,10):'',sold:r.sale_date?String(r.sale_date).slice(0,10):'',saleCode:r.sale_code||'',customer:r.customer_name||'USER',phone:r.customer_phone||'',storeStatus:r.store_warranty_status,storeEnd:r.store_warranty_end||'',storeDays:r.store_remaining_days,dealerStatus:r.dealer_warranty_status,dealerEnd:r.dealer_warranty_end_text||'',dealerDays:r.dealer_remaining_days,purchase:r.purchase_reference||''}; %>
<tr><td><strong><%= r.product_name %></strong><div class="small text-muted"><%= [r.brand,r.model].filter(Boolean).join(' · ') || '-' %></div></td><td><div><%= r.serial_number||'-' %></div><code><%= r.product_code||'-' %></code><div class="small text-muted"><%= r.internal_code %></div></td><td><%= r.sale_code||'-' %><div class="small text-muted"><%= r.sale_date?new Date(r.sale_date).toLocaleDateString():'Not sold' %></div></td><td><span class="badge bg-<%= r.source_type==='dealer'?'info text-dark':r.source_type==='own'?'primary':'secondary' %>"><%= r.source_type %></span><div class="small"><%= r.supplier_name||'-' %></div></td><td><%= r.customer_name||'USER' %><div class="small text-muted"><%= r.customer_phone||'' %></div></td><td><span class="stock-pill stock-<%= statusClass(r.store_warranty_status) %>"><%= r.store_warranty_status %></span><div class="small text-muted mt-1"><%= remainText(r.store_warranty_status,r.store_remaining_days) %></div></td><td><span class="stock-pill stock-<%= statusClass(r.dealer_warranty_status) %>"><%= r.dealer_warranty_status %></span><div class="small text-muted mt-1"><%= remainText(r.dealer_warranty_status,r.dealer_remaining_days) %></div></td><td class="text-end"><button class="btn btn-sm btn-outline-primary" onclick='openDetail(<%- JSON.stringify(detail).replace(/</g,"\\u003c") %>)'><i class="bi bi-eye"></i> Detail</button><% if(['admin','manager'].includes(user.role) && r.last_sale_id){ %><button class="btn btn-sm btn-primary mt-1" onclick='openClaim(<%- JSON.stringify({id:r.id,product:r.product_name,serial:r.serial_number||r.internal_code,store:r.store_warranty_status,dealer:r.dealer_warranty_status}).replace(/</g,"\\u003c") %>)'>Claim</button><% } %></td></tr>
<% }) %></tbody></table></div></div>

<div class="modal fade" id="detailModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><div><h5 class="mb-0">Item Warranty Detail</h5><small class="text-muted" id="detailTitle"></small></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3" id="detailGrid"></div></div></div></div></div>

<% if(['admin','manager'].includes(user.role)){ %>
<div class="card mb-4"><div class="card-header"><div><h5 class="mb-0"><i class="bi bi-arrow-left-right"></i> Returns / Exchange / Sale Correction</h5><small class="text-muted">Use Return for refunds; Correct for wrong item / exchange. Serial-required products must use exact units.</small></div></div><div class="card-body p-0 table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Sale</th><th>Date</th><th>Customer</th><th>Product</th><th>Qty</th><th>Returned</th><th>Price</th><th class="text-end">Actions</th></tr></thead><tbody><% saleItems.forEach(function(s){var remain=Number(s.quantity)-Number(s.returned_quantity||0);%><tr><td><strong><%= s.sale_code %></strong><div class="small text-muted"><%= s.status %></div></td><td><%= new Date(s.created_at).toLocaleString() %></td><td><%= s.customer_name||'USER' %></td><td><%= s.product_name %></td><td><%= s.quantity %></td><td><%= s.returned_quantity||0 %></td><td><%= money(s.unit_price) %></td><td class="text-end"><div class="action-group justify-content-end"><% if(remain>0 && !['cancelled','returned'].includes(s.status)){ %><button class="btn btn-sm btn-outline-success" onclick='openReturn(<%- JSON.stringify({id:s.sale_item_id,sale:s.sale_code,product:s.product_name,remaining:remain,price:s.unit_price}).replace(/</g,"\\u003c") %>)' title="Return / Refund"><i class="bi bi-arrow-return-left"></i></button><button class="btn btn-sm btn-outline-warning" onclick='openCorrection(<%- JSON.stringify({id:s.sale_item_id,sale:s.sale_code,product:s.product_name,remaining:remain,price:s.unit_price}).replace(/</g,"\\u003c") %>)' title="Correct / Exchange"><i class="bi bi-arrow-left-right"></i></button><button class="btn btn-sm btn-outline-danger" onclick='openVoid(<%= s.sale_id %>,<%- JSON.stringify(s.sale_code) %>)' title="Void entire sale"><i class="bi bi-x-octagon"></i></button><% } %></div></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="card-header"><h5><i class="bi bi-clipboard2-pulse"></i> Warranty Claims</h5></div><div class="card-body p-0 table-responsive"><table class="table table-hover compact-table mb-0"><thead><tr><th>Claim</th><th>Item</th><th>Dealer</th><th>Warranty</th><th>Issue</th><th>Status</th><th>Action</th></tr></thead><tbody><% claims.forEach(function(c){ %><tr><td><strong><%= c.claim_code %></strong><div class="small text-muted"><%= new Date(c.created_at).toLocaleString() %></div></td><td><%= c.product_name %><div class="small"><%= c.serial_number||c.internal_code %></div></td><td><%= c.supplier_name||'Own / Legacy' %></td><td><div>Store: <%= c.store_warranty_status %></div><div>Dealer: <%= c.dealer_warranty_status %></div></td><td><%= c.issue_description %></td><td><span class="badge bg-light text-dark border"><%= c.status %></span></td><td><% if(!['closed','rejected','replaced'].includes(c.status)){ %><button class="btn btn-sm btn-outline-primary" onclick='openResolve(<%- JSON.stringify({id:c.id,claim:c.claim_code,product:c.product_name}).replace(/</g,"\\u003c") %>)'>Update</button><% } else { %><%= c.resolution||'-' %><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="modal fade" id="claimModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" action="/after-sales/claim"><div class="modal-header"><h5>Open Warranty Claim</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="inventory_unit_id" id="claimUnitId"><div class="alert alert-light border" id="claimSummary"></div><label>Issue / Problem</label><textarea name="issue_description" class="form-control mb-3" rows="4" required></textarea><label>Requested Action</label><select name="requested_action" class="form-select"><option value="check">Check / Diagnose</option><option value="repair">Repair</option><option value="replace">Replace</option><option value="send_to_dealer">Send to Dealer</option></select></div><div class="modal-footer"><button class="btn btn-primary">Create Claim</button></div></form></div></div></div>
<div class="modal fade" id="correctionModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><form method="POST" action="/after-sales/correct-sale" id="correctionForm"><div class="modal-header"><div><h5 class="mb-0">Correct / Exchange Sale Item</h5><small class="text-muted">Choose exact sold and replacement units when needed.</small></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="sale_item_id" id="corrSaleItemId"><input type="hidden" name="return_unit_ids_json" id="corrReturnUnitIds" value="[]"><input type="hidden" name="replacement_unit_ids_json" id="corrReplacementUnitIds" value="[]"><div class="alert alert-warning py-2" id="corrSummary"></div><div class="row g-2"><div class="col-md-3"><label class="form-label">Qty</label><input name="quantity" id="corrQty" type="number" min="1" value="1" class="form-control" required></div><div class="col-md-9"><label class="form-label">Correction</label><select name="correction_type" id="corrType" class="form-select" onchange="toggleReplacement()"><option value="wrong_item_return">Return wrong item only</option><option value="wrong_item_replace">Return + replace / exchange</option></select></div><div class="col-12"><label class="form-label">Sold Serial / Unit to return</label><div id="corrSoldUnits" class="unit-choice-box"><span class="text-muted small">Loading...</span></div></div><div class="col-12 d-none" id="replacementBox"><label class="form-label">Replacement Product</label><select name="replacement_product_id" id="corrReplacementProduct" class="form-select mb-2 product-search-select" data-placeholder="Search replacement product / code / barcode / unit / serial" onchange="loadReplacementUnits()"><option value="">Select product</option><% products.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %> (Stock <%= p.stock_qty %>)</option><% }) %></select><label class="form-label">Replacement Serial / Unit</label><div id="corrReplacementUnits" class="unit-choice-box"><span class="text-muted small">Select a replacement product.</span></div></div><div class="col-12"><label class="form-label">Reason</label><textarea name="reason" class="form-control" rows="2" required></textarea></div></div></div><div class="modal-footer"><button class="btn btn-warning">Save Correction</button></div></form></div></div></div>
<div class="modal fade" id="returnModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><form method="POST" action="/after-sales/return-sale" id="returnForm"><div class="modal-header"><h5>Return / Refund</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="sale_item_id" id="returnSaleItemId"><input type="hidden" name="unit_ids_json" id="returnUnitIds" value="[]"><div class="alert alert-light border py-2" id="returnSummary"></div><div class="row g-2"><div class="col-md-3"><label class="form-label">Qty</label><input name="quantity" id="returnQty" type="number" min="1" value="1" class="form-control"></div><div class="col-md-4"><label class="form-label">Condition</label><select name="condition" class="form-select"><option value="good">Good · back to stock</option><option value="damaged">Damaged</option><option value="inspection">Needs inspection</option></select></div><div class="col-md-5"><label class="form-label">Refund Amount</label><input name="refund_amount" id="returnRefund" type="number" min="0" step="0.01" class="form-control"></div><div class="col-12"><label class="form-label">Serial / Unit being returned</label><div id="returnSoldUnits" class="unit-choice-box"></div></div><div class="col-12"><label class="form-label">Reason</label><textarea name="reason" class="form-control" rows="2" required></textarea></div></div></div><div class="modal-footer"><button class="btn btn-success">Confirm Return</button></div></form></div></div></div>
<div class="modal fade" id="voidModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content"><form method="POST" id="voidForm"><div class="modal-header"><h5>Void Entire Sale</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="voidSummary" class="alert alert-danger small"></div><label class="form-label">Reason</label><textarea name="reason" class="form-control" rows="3" required></textarea></div><div class="modal-footer"><button class="btn btn-danger">Void Sale</button></div></form></div></div></div>
<div class="modal fade" id="resolveModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" id="resolveForm"><div class="modal-header"><h5>Update Warranty Claim</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-light border" id="resolveSummary"></div><label>Resolution</label><select name="resolution" id="resolutionType" class="form-select mb-3" onchange="toggleResolveReplacement()"><option value="repaired_return">Repaired / Return to customer</option><option value="send_to_dealer">Send to Dealer</option><option value="replace">Replace Item</option><option value="reject">Reject Claim</option></select><div class="d-none mb-3" id="resolveReplacementBox"><label>Replacement Product</label><select name="replacement_product_id" class="form-select product-search-select" data-placeholder="Search replacement product / code / barcode / unit / serial"><option value="">Same product</option><% products.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %> (Stock <%= p.stock_qty %>)</option><% }) %></select></div><label>Notes</label><textarea name="notes" class="form-control" rows="3"></textarea></div><div class="modal-footer"><button class="btn btn-primary">Update Claim</button></div></form></div></div></div>
<% } %>
<script>
function safe(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function daysText(status,days){if(status==='valid')return Number(days)===0?'Ends today':days+' day(s) left';if(status==='expired')return Math.abs(Number(days)||0)+' day(s) expired';if(status==='not_applicable')return 'N/A';return 'Not available'}
function detailCell(label,value,wide){return '<div class="'+(wide?'col-md-12':'col-md-6')+'"><div class="warranty-detail-box"><div class="small text-muted">'+safe(label)+'</div><div class="fw-semibold">'+safe(value||'-')+'</div></div></div>'}
function openDetail(x){document.getElementById('detailTitle').textContent=x.product+(x.model?' · '+x.model:'');var store=(x.storeStatus||'none')+' · '+daysText(x.storeStatus,x.storeDays)+(x.storeEnd?' · ends '+x.storeEnd:'');var dealer=(x.dealerStatus||'none')+' · '+daysText(x.dealerStatus,x.dealerDays)+(x.dealerEnd?' · ends '+x.dealerEnd:'');document.getElementById('detailGrid').innerHTML=detailCell('Product Code',x.code)+detailCell('Serial Number',x.serial||'-')+detailCell('Unit Code',x.stockCode)+detailCell('Source',x.source)+detailCell('Dealer / Supplier',x.dealer||'-')+detailCell('Received Date',x.received||'-')+detailCell('Sale Code',x.saleCode||'-')+detailCell('Sold Date',x.sold||'-')+detailCell('Customer',x.customer+(x.phone?' · '+x.phone:''),true)+detailCell('Store Warranty',store,true)+detailCell('Dealer Warranty',dealer,true)+detailCell('Purchase Reference',x.purchase||'-',true);bootstrap.Modal.getOrCreateInstance(document.getElementById('detailModal')).show()}
<% if(['admin','manager'].includes(user.role)){ %>
function openClaim(x){claimUnitId.value=x.id;claimSummary.textContent=x.product+' · Serial/Code: '+x.serial+' · Store: '+x.store+' · Dealer: '+x.dealer;bootstrap.Modal.getOrCreateInstance(claimModal).show()}
function unitChoices(units,name){if(!units.length)return '<span class="text-muted small">No tracked unit found.</span>';return units.map(function(u){return '<label class="unit-choice"><input type="checkbox" name="'+name+'" value="'+u.id+'"><span><strong>'+(u.serial_number||u.internal_code)+'</strong><small>'+u.internal_code+'</small></span></label>'}).join('')}
function loadSoldUnits(itemId,target){target.innerHTML='<span class="text-muted small">Loading...</span>';return fetch('/after-sales/sale-item/'+itemId+'/units').then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Load failed');target.innerHTML=unitChoices(d.units,target.id==='returnSoldUnits'?'return-unit':'corr-return-unit');target.dataset.tracking=d.line.tracking_mode||'optional';return d}).catch(e=>{target.innerHTML='<span class="text-danger small">'+e.message+'</span>'})}
function openCorrection(x){corrSaleItemId.value=x.id;corrQty.max=x.remaining;corrQty.value=1;corrSummary.textContent=x.sale+' · '+x.product+' · Remaining '+x.remaining+' · $'+Number(x.price).toFixed(2);corrReplacementProduct.value='';corrReplacementUnits.innerHTML='<span class="text-muted small">Select a replacement product.</span>';loadSoldUnits(x.id,corrSoldUnits);toggleReplacement();bootstrap.Modal.getOrCreateInstance(correctionModal).show()}
function toggleReplacement(){replacementBox.classList.toggle('d-none',corrType.value!=='wrong_item_replace')}
function loadReplacementUnits(){var id=corrReplacementProduct.value;if(!id){corrReplacementUnits.innerHTML='<span class="text-muted small">Select a replacement product.</span>';return}corrReplacementUnits.innerHTML='<span class="text-muted small">Loading...</span>';fetch('/after-sales/product/'+id+'/available-units').then(r=>r.json()).then(d=>{if(!d.success)throw new Error(d.error||'Load failed');corrReplacementUnits.dataset.tracking=d.product.tracking_mode||'optional';corrReplacementUnits.innerHTML=unitChoices(d.units,'corr-replacement-unit')}).catch(e=>corrReplacementUnits.innerHTML='<span class="text-danger small">'+e.message+'</span>')}
correctionForm.addEventListener('submit',function(e){var qty=Number(corrQty.value)||1,ret=Array.from(corrSoldUnits.querySelectorAll('input:checked')).map(x=>Number(x.value)),rep=Array.from(corrReplacementUnits.querySelectorAll('input:checked')).map(x=>Number(x.value));if(corrSoldUnits.dataset.tracking==='required'&&ret.length!==qty){e.preventDefault();return showToast('Select exactly '+qty+' sold Serial / Unit(s).','warning')}if(ret.length&&ret.length!==qty){e.preventDefault();return showToast('Selected sold units must match Qty.','warning')}if(corrType.value==='wrong_item_replace'){if(!corrReplacementProduct.value){e.preventDefault();return showToast('Select replacement product.','warning')}if(corrReplacementUnits.dataset.tracking==='required'&&rep.length!==qty){e.preventDefault();return showToast('Select exactly '+qty+' replacement Serial / Unit(s).','warning')}if(rep.length&&rep.length!==qty){e.preventDefault();return showToast('Selected replacement units must match Qty.','warning')}}corrReturnUnitIds.value=JSON.stringify(ret);corrReplacementUnitIds.value=JSON.stringify(rep)})
function openReturn(x){returnSaleItemId.value=x.id;returnQty.max=x.remaining;returnQty.value=1;returnRefund.value=Number(x.price).toFixed(2);returnSummary.textContent=x.sale+' · '+x.product+' · Remaining '+x.remaining;loadSoldUnits(x.id,returnSoldUnits);bootstrap.Modal.getOrCreateInstance(returnModal).show()}
returnForm.addEventListener('submit',function(e){var qty=Number(returnQty.value)||1,ids=Array.from(returnSoldUnits.querySelectorAll('input:checked')).map(x=>Number(x.value));if(returnSoldUnits.dataset.tracking==='required'&&ids.length!==qty){e.preventDefault();return showToast('Select exactly '+qty+' returned Serial / Unit(s).','warning')}if(ids.length&&ids.length!==qty){e.preventDefault();return showToast('Selected units must match return Qty.','warning')}returnUnitIds.value=JSON.stringify(ids)})
function openVoid(id,code){voidForm.action='/after-sales/void-sale/'+id;voidSummary.textContent='Void '+code+'? All remaining sold items will return to stock. This is blocked after a partial return.';bootstrap.Modal.getOrCreateInstance(voidModal).show()}
function openResolve(x){resolveForm.action='/after-sales/claim/'+x.id+'/resolve';resolveSummary.textContent=x.claim+' · '+x.product;bootstrap.Modal.getOrCreateInstance(resolveModal).show()}
function toggleResolveReplacement(){resolveReplacementBox.classList.toggle('d-none',resolutionType.value!=='replace')}
<% } %>
</script>
