<div class="d-flex justify-content-between align-items-center mt-3 mb-3"><div><h2 class="mb-1"><i class="bi bi-truck"></i> <%= t('suppliers') %></h2><div class="text-muted small">Dealer / supplier contact list.</div></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#supplierModal"><i class="bi bi-plus-lg"></i> Add Supplier</button></div>
<div class="modal fade" id="supplierModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" action="/suppliers/create"><div class="modal-header"><h5>Add Supplier</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-2"><div class="col-12"><label>Name</label><input name="name" class="form-control" required></div><div class="col-6"><label>Phone</label><input name="phone" class="form-control"></div><div class="col-6"><label>Email</label><input name="email" type="email" class="form-control"></div><div class="col-12"><label>Address</label><textarea name="address" class="form-control" rows="2"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save</button></div></form></div></div></div>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table table-hover align-middle compact-table mb-0"><thead class="table-dark"><tr><th>Supplier</th><th>Phone</th><th>Email</th><th>Address</th><th class="text-center">Purchases</th><th class="text-end">Due</th><th class="text-end">Actions</th></tr></thead><tbody><% suppliers.forEach(function(s){ %><tr><td class="fw-semibold"><%= s.name %></td><td><%= s.phone||'-' %></td><td><%= s.email||'-' %></td><td class="text-muted"><%= s.address||'-' %></td><td class="text-center"><%= s.purchase_count||0 %></td><td class="text-end <%= Number(s.due_balance)>0?'text-danger fw-semibold':'' %>"><%= money(s.due_balance||0) %></td><td class="text-end"><div class="action-group justify-content-end"><button class="btn btn-sm btn-outline-primary" onclick='openSupplierEdit(<%- JSON.stringify({id:s.id,name:s.name,phone:s.phone||"",email:s.email||"",address:s.address||""}).replace(/</g,"\\u003c") %>)'><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(<%= s.id %>,<%- JSON.stringify(s.name) %>)"><i class="bi bi-trash"></i></button></div></td></tr><% }) %></tbody></table></div></div>
<div class="modal fade" id="supplierEditModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" id="supplierEditForm"><div class="modal-header"><h5>Edit Supplier</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-2"><div class="col-12"><label>Name</label><input id="seName" name="name" class="form-control" required></div><div class="col-6"><label>Phone</label><input id="sePhone" name="phone" class="form-control"></div><div class="col-6"><label>Email</label><input id="seEmail" name="email" type="email" class="form-control"></div><div class="col-12"><label>Address</label><textarea id="seAddress" name="address" class="form-control"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save Changes</button></div></form></div></div></div>
<script>function openSupplierEdit(s){supplierEditForm.action='/suppliers/update/'+s.id;seName.value=s.name;sePhone.value=s.phone;seEmail.value=s.email;seAddress.value=s.address;bootstrap.Modal.getOrCreateInstance(supplierEditModal).show()}function deleteSupplier(id,name){confirmDelete('Disable supplier "'+name+'"?',function(){fetch('/suppliers/delete/'+id,{method:'POST',redirect:'follow'}).then(()=>location.reload())})}</script>
